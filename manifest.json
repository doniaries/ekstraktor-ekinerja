{
  "manifest_version": 3,
  "name": "Ekstraktor E-Kinerja",
  "description": "Membantu mengekstrak dan mengisi data Rencana Aksi E-Kinerja secara otomatis.",
  "author": "doni aries 2026",
  "version": "1.0.0",
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "clipboardRead",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://kinerja.bkn.go.id/*",
    "https://docs.google.com/*",
    "https://drive.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://kinerja.bkn.go.id/*"],
      "js": ["content-ekinerja.js"]
    },
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["content-drive.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Ekstraktor E-Kinerja",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
